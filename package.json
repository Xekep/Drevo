{
  "name": "drevo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/server/index.ts",
    "start": "node --experimental-strip-types src/server/index.ts --production",
    "build": "vite build",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:worker": "node --test tests/built-worker.test.mjs",
    "test:postgres": "node --experimental-strip-types tests/integration/postgres-write-tests.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests ops/postgres vite.config.ts",
    "preview:static": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests docs README.md",
    "backfill:faces": "node --experimental-strip-types src/server/browser-face-backfill.ts",
    "prebackfill:faces": "npm run prepare:models",
    "prepare:models": "node --experimental-strip-types src/server/prepare-models.ts",
    "predev": "npm run prepare:models",
    "prebuild": "npm run prepare:models"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@internetarchive/bookreader": "5.0.0-117",
    "@vladmandic/human": "3.3.6",
    "@xyflow/react": "^12.11.6",
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "elkjs": "^0.12.0",
    "jspdf": "4.2.1",
    "katex": "0.18.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.42.0",
    "mermaid": "^11.17.2",
    "nodemailer": "^10.0.13",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "saxes": "^6.0.0",
    "sharp": "0.35.5",
    "svg2pdf.js": "2.8.1",
    "unified": "^11.0.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/babel__core": "^7.20.5",
    "@types/katex": "^0.16.8",
    "@types/leaflet": "^1.9.21",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.2"
  },
  "type": "module",
  "overrides": {
    "jquery-ui": "1.14.2",
    "katex": "$katex"
  }
}
