{
  "name": "drevo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/server/index.ts",
    "start": "node --experimental-strip-types src/server/index.ts --production",
    "build": "vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts",
    "preview:static": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests docs README.md",
    "prepare:models": "node --experimental-strip-types src/server/prepare-models.ts",
    "predev": "npm run prepare:models",
    "prebuild": "npm run prepare:models"
  },
  "dependencies": {
    "@vladmandic/face-api": "1.7.15",
    "@xyflow/react": "^12.11.6",
    "lucide-react": "^1.42.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
