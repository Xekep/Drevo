# Серверные переменные. Не добавлять префикс VITE_ к credentials.
# Можно использовать уже сохранённые в админке Drevo настройки AI Studio.
YANDEX_AI_API_KEY=
YANDEX_AI_FOLDER_ID=
YANDEX_AI_MODEL=
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1

# Сохранённый в админке переключатель имеет приоритет над окружением.
AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_PROVIDER=yandex
AI_WEB_SEARCH_TIMEOUT_MS=25000
# Scope по умолчанию всегда trusted; global задаётся явно в tool call.

# Вход в архив. PUBLIC_ORIGIN — точный публичный origin без завершающего /.
PUBLIC_ORIGIN=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
INITIAL_ADMIN_YANDEX_ID=
# ID приложения VK ID для веб-платформы. Пустое значение отключает вход через VK.
# Callback: <PUBLIC_ORIGIN>/auth/vk/callback. В Authorization Code + PKCE секрет VK не нужен.
VK_CLIENT_ID=
