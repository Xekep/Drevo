# Local-stage example for /etc/pgbackrest/pgbackrest.conf.
# This repository shares the PostgreSQL server's disk; it is not disaster recovery.
[drevo]
pg1-path=/var/lib/postgresql/18/main

[global]
repo1-path=/var/lib/pgbackrest
repo1-retention-full=2
start-fast=y
log-level-file=info

[global:archive-push]
compress-level=3
